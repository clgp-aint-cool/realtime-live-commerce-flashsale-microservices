{
  "name": "moderation-service",
  "version": "0.1.0",
  "private": true,
  "description": "Nhận webhook cảnh báo moderation từ AWS, ghi log, thông báo vào chat",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=../../.env dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"unit tests: chưa có, xem tests/e2e ở thư mục gốc\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "@types/pg": "^8.11.0"
  }
}
