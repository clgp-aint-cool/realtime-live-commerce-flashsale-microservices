{
  "name": "live-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Quản lý người bán, kênh IVS, stream key, phiên live, ghim sản phẩm",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=../../.env dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"unit tests: chưa có, xem tests/e2e ở thư mục gốc\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-ivs": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "fflate": "^0.8.2",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "~5.9.3"
  }
}
