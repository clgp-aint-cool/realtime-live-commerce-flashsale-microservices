# Sao chép thành .env. KHÔNG commit file .env.
# docker compose tự đọc .env cho các biến ${...}; giá trị mặc định đã đủ để chạy local.

# --- Dùng chung ---
ADMIN_TOKEN=dev-admin-token
WEBHOOK_SHARED_SECRET=dev-webhook-secret
INTERNAL_API_TOKEN=dev-internal-token
# Phòng chat dự phòng của moderation khi không tra được phiên theo channelArn
CHAT_ROOM=main

# --- Tài khoản người mua (auth-service, order-service) ---
# Khóa ký JWT, >= 32 ký tự. Tạo: openssl rand -base64 48
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
# true: cho phép đặt hàng không đăng nhập (e2e, k6). Production: false
ALLOW_GUEST_ORDERS=true

# --- live-manager / AWS IVS (xem docs/live-manager.md) ---
# mock: không gọi AWS, kênh giả lưu trong Redis, video là luồng demo công khai của AWS.
# aws:  tạo kênh IVS thật cho từng người bán, cần IAM user quyền tối thiểu (docs/iam-live-manager-policy.json).
IVS_MODE=mock
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Recording configuration dùng chung, gắn vào mọi kênh (để trống = không ghi hình)
IVS_RECORDING_CONFIGURATION_ARN=

# --- Chỉ dùng khi chạy service trực tiếp bằng `npm run dev` (ngoài container) ---
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://live:live@localhost:5432/livecommerce
CHAT_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
LIVE_MANAGER_URL=http://localhost:3005
